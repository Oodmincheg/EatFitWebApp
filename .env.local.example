# cp .env.local.example .env.local  — the dev server reloads it on save.

# MongoDB Atlas (users, plans, progress, orders, dishes, silpo_oauth, silpo_clients)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mealplanner

# Any OpenAI-compatible /chat/completions endpoint that honors
# response_format json_object and image_url parts (fridge photos).
# OpenRouter: https://openrouter.ai/api/v1 + anthropic/claude-sonnet-5
LITELLM_BASE_URL=https://openrouter.ai/api/v1
LITELLM_API_KEY=sk-or-...
LITELLM_MODEL=anthropic/claude-sonnet-5

# Firebase web config for Google sign-in. Optional: leave empty to hide the
# Google button and run guest-only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Silpo MCP. No developer credentials: EatFit registers itself as an OAuth
# client on first use, each user logs in on silpo.ua from the Cart page.
# Uncomment APP_BASE_URL only when a custom domain and *.vercel.app both
# serve traffic, so Silpo sees one redirect URI.
# SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# APP_BASE_URL=https://eatfit.example
